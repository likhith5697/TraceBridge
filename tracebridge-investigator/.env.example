# Copy to .env (or export these in your shell) before running an investigation.

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=

# To use Claude instead, set LLM_PROVIDER=anthropic, LLM_MODEL=claude-sonnet-5,
# and ANTHROPIC_API_KEY instead of OPENAI_API_KEY.

# How tracebridge-mcp is launched (stdio subprocess). Defaults assume this
# repo layout: tracebridge-investigator/ next to tracebridge-mcp/.
# MCP_SERVER_COMMAND is normally left unset - it's auto-resolved to
# tracebridge-mcp's own .venv interpreter (see config.py). Only set it if
# your tracebridge-mcp isn't at ../tracebridge-mcp or uses a different venv.
# MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=-m,tracebridge_mcp.server
MCP_SERVER_CWD=../tracebridge-mcp
MCP_SERVER_PYTHONPATH=src

MAX_ITERATIONS=8
