# Copy to .env (or export these in your shell) before running the server.
# These defaults match docker-compose.yml exactly - no production credential
# should ever be placed in this file.

OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_TIMEOUT_SECONDS=5

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tracebridge
POSTGRES_USER=tracebridge
POSTGRES_PASSWORD=tracebridge
POSTGRES_TIMEOUT_SECONDS=5

# Read-only Docker runtime evidence (Phase 8). Points at docker-socket-proxy,
# never at the host's docker.sock directly - see docker-compose.yml.
DOCKER_HOST=tcp://docker-socket-proxy:2375
DOCKER_TIMEOUT_SECONDS=5
DEPENDENCY_PROBE_TIMEOUT_SECONDS=2
